# API URL for the backend Elysia server
# In development with Wrangler, this is usually http://localhost:8787
VITE_API_URL=http://localhost:8787

# Note: In production (Cloudflare Pages), you can set this directly in the Cloudflare dashboard
# or inside your wrangler.toml file.

# Captcha Public Site Keys
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
VITE_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key_here
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
