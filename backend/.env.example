# =======================================================
# TEC Voting System - Backend Environment Variable Example
# =======================================================
#
# Copy this file to .env and fill in your credentials.
# In production on Cloudflare, these should be set as secrets.

# -- Server Configuration --
NODE_ENV=development
HOST=localhost
PORT=3000

# -- CORS Configuration --
# Controls which frontend domains can access this API.
# Use a comma-separated list for multiple origins.
# Example: CORS_ORIGIN=http://localhost:5173,https://your-production-domain.com
CORS_ORIGIN=http://localhost:5173

# -- Database (Neon + Hyperdrive) --
# This is the main connection string, which includes the password.
# It's used by Hyperdrive in production and for local dev.
# Example: postgres://user:password@endpoint.neon.tech/neondb
DATABASE_URL=

# -- JWT Authentication --
# A long, random, and secret string for signing tokens.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# -- Upstash Redis (For Serverless Rate Limiting) --
# Optional for local development, but required for production security.
# Get these from your Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -- Captcha Provider Secrets --
# You can use the default test keys for development.
# For production, get your own keys from Google/hCaptcha/Cloudflare.
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA