{
  "name": "tec-voting-backend",
  "version": "1.0.0",
  "description": "TEC Online Voting System Backend - Edge-native API exclusively built for Cloudflare Workers using ElysiaJS",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "bun test",
    "start:local": "bun run src/index.ts",
    "build:local": "bun build src/index.ts --outdir ./dist --target bun"
  },
  "dependencies": {
    "@elysiajs/cors": "latest",
    "@elysiajs/jwt": "latest",
    "@elysiajs/swagger": "latest",
    "drizzle-orm": "latest",
    "elysia": "latest",
    "postgres": "latest",
    "valibot": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/bun": "latest",
    "drizzle-kit": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
